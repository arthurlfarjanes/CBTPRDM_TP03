<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RastreamentoApp.Views.ResultadoPage"
             Title="Detalhes do Rastreamento"
             BackgroundColor="#F3F4F6">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Card Resumo do Pacote -->
            <Frame BackgroundColor="White"
                   CornerRadius="12"
                   Padding="20"
                   HasShadow="True"
                   BorderColor="#E5E7EB">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*, Auto">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="CÓDIGO DO PACOTE"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   TextColor="#6B7280" />
                            <Label Text="{Binding PacoteEncontrado.IdPacote}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="#111827" />
                        </VerticalStackLayout>

                        <Frame Grid.Column="1"
                               BackgroundColor="{Binding PacoteEncontrado.CorStatus}"
                               Padding="12,6"
                               CornerRadius="16"
                               HasShadow="False"
                               VerticalOptions="Center">
                            <Label Text="{Binding PacoteEncontrado.Status}"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="12" />
                        </Frame>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#E5E7EB" Margin="0,4" />

                    <!-- Localização Atual -->
                    <VerticalStackLayout Spacing="2">
                        <Label Text="📍 Localização Atual"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="#6B7280" />
                        <Label Text="{Binding PacoteEncontrado.LocalizacaoAtual}"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#1F2937" />
                    </VerticalStackLayout>

                    <!-- Datas de Envio e Previsão -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,4,0,0">
                        <Frame Grid.Column="0"
                               BackgroundColor="#F9FAFB"
                               BorderColor="#E5E7EB"
                               CornerRadius="8"
                               Padding="12"
                               HasShadow="False">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="📅 Data de Envio"
                                       FontSize="12"
                                       TextColor="#6B7280" />
                                <Label Text="{Binding PacoteEncontrado.DataEnvio}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#111827" />
                            </VerticalStackLayout>
                        </Frame>

                        <Frame Grid.Column="1"
                               BackgroundColor="#F9FAFB"
                               BorderColor="#E5E7EB"
                               CornerRadius="8"
                               Padding="12"
                               HasShadow="False">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="🚚 Previsão de Entrega"
                                       FontSize="12"
                                       TextColor="#6B7280" />
                                <Label Text="{Binding PacoteEncontrado.DataPrevistaEntrega}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#111827" />
                            </VerticalStackLayout>
                        </Frame>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Seção de Histórico de Eventos -->
            <Label Text="Histórico de Movimentações"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="#1F2937"
                   Margin="4,4,0,0" />

            <CollectionView ItemsSource="{Binding PacoteEncontrado.HistoricoEventos}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="White"
                               CornerRadius="10"
                               Padding="16"
                               Margin="0,0,0,10"
                               HasShadow="False"
                               BorderColor="#E5E7EB">
                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="14">
                                <BoxView Grid.Column="0"
                                         WidthRequest="4"
                                         Color="#2563EB"
                                         CornerRadius="2"
                                         VerticalOptions="Fill" />

                                <VerticalStackLayout Grid.Column="1" Spacing="4">
                                    <Label Text="{Binding Descricao}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#1F2937" />
                                    <Label Text="{Binding Local, StringFormat='Local: {0}'}"
                                           FontSize="13"
                                           TextColor="#4B5563" />
                                    <Label Text="{Binding DataHora}"
                                           FontSize="12"
                                           TextColor="#9CA3AF" />
                                </VerticalStackLayout>
                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Botão para Nova Consulta -->
            <Button Text="Realizar Nova Consulta"
                    Command="{Binding VoltarCommand}"
                    BackgroundColor="#1F2937"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="48"
                    Margin="0,8,0,20" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>