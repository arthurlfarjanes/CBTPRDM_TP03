<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RastreamentoApp.Views.BuscaPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F1F5F4">

    <ScrollView>
        <Grid RowDefinitions="Auto,*" MaximumWidthRequest="600">

            <!-- Topo escuro (cor sólida) -->
            <Border Grid.Row="0"
                    BackgroundColor="#0B3B36"
                    StrokeThickness="0"
                    Padding="24,56,24,72">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,32,32" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="Rastreamento"
                           FontSize="13"
                           FontAttributes="Bold"
                           CharacterSpacing="2"
                           TextColor="#5EEAD4" />
                    <Label Text="Onde está a sua encomenda?"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="Digite o código e acompanhe cada etapa da entrega."
                           FontSize="15"
                           TextColor="#A7C4C0" />
                </VerticalStackLayout>
            </Border>

            <!-- Conteúdo sobreposto ao topo -->
            <VerticalStackLayout Grid.Row="1" Margin="20,-44,20,24" Spacing="24">

                <Border BackgroundColor="White" Stroke="#E3EAE8" StrokeThickness="1" Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#0B3B36" Opacity="0.10" Radius="24" Offset="0,8" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <Label Text="Código de rastreamento"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="#475569" />

                        <Border Stroke="#D5DEDC" StrokeThickness="1.5" BackgroundColor="#F8FAFA" Padding="16,0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="14" />
                            </Border.StrokeShape>
                            <Entry Placeholder="Ex: BR123456789"
                                   Text="{Binding CodigoRastreamento}"
                                   Keyboard="Plain"
                                   FontSize="17"
                                   HeightRequest="54"
                                   TextColor="#0F172A"
                                   PlaceholderColor="#94A3B8"
                                   ClearButtonVisibility="WhileEditing"
                                   ReturnCommand="{Binding BuscarPacoteCommand}" />
                        </Border>

                        <Button Text="Rastrear"
                                Command="{Binding BuscarPacoteCommand}"
                                BackgroundColor="#0F766E"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="17"
                                CornerRadius="14"
                                HeightRequest="54" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="12">
                    <Label Text="Experimente um exemplo"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#334155"
                           Margin="4,0,0,0" />

                    <Button Text="BR123456789"
                            Command="{Binding PreencherCodigoCommand}"
                            CommandParameter="BR123456789"
                            BackgroundColor="White"
                            TextColor="#0F172A"
                            BorderColor="#E3EAE8"
                            BorderWidth="1"
                            FontSize="15"
                            CornerRadius="14"
                            HeightRequest="52"
                            HorizontalOptions="Fill" />
                    <Button Text="BR987654321"
                            Command="{Binding PreencherCodigoCommand}"
                            CommandParameter="BR987654321"
                            BackgroundColor="White"
                            TextColor="#0F172A"
                            BorderColor="#E3EAE8"
                            BorderWidth="1"
                            FontSize="15"
                            CornerRadius="14"
                            HeightRequest="52" />
                    <Button Text="BR555666777"
                            Command="{Binding PreencherCodigoCommand}"
                            CommandParameter="BR555666777"
                            BackgroundColor="White"
                            TextColor="#0F172A"
                            BorderColor="#E3EAE8"
                            BorderWidth="1"
                            FontSize="15"
                            CornerRadius="14"
                            HeightRequest="52" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
