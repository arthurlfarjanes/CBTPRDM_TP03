<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RastreamentoApp.Views.ResultadoPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F1F5F4">

    <ScrollView>
        <Grid RowDefinitions="Auto,*" MaximumWidthRequest="600">

            <!-- Topo escuro com resumo -->
            <Border Grid.Row="0"
                    BackgroundColor="#0B3B36"
                    StrokeThickness="0"
                    Padding="24,48,24,72">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,32,32" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <Button Text="‹  Nova consulta"
                            Command="{Binding VoltarCommand}"
                            BackgroundColor="Transparent"
                            TextColor="#5EEAD4"
                            FontAttributes="Bold"
                            FontSize="15"
                            Padding="0"
                            HorizontalOptions="Start" />

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Código do pacote"
                                   FontSize="13"
                                   TextColor="#A7C4C0" />
                            <Label Text="{Binding PacoteEncontrado.IdPacote}"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                BackgroundColor="{Binding PacoteEncontrado.CorStatus}"
                                StrokeThickness="0"
                                Padding="14,7"
                                VerticalOptions="End">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="20" />
                            </Border.StrokeShape>
                            <Label Text="{Binding PacoteEncontrado.Status}"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   FontSize="13" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Grid.Row="1" Margin="20,-44,20,24" Spacing="20">

                <!-- Card de informações -->
                <Border BackgroundColor="White" Stroke="#E3EAE8" StrokeThickness="1" Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#0B3B36" Opacity="0.10" Radius="24" Offset="0,8" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Localização atual" FontSize="12" TextColor="#64748B" />
                            <Label Text="{Binding PacoteEncontrado.LocalizacaoAtual}"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A" />
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="#EEF2F1" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="Enviado em" FontSize="12" TextColor="#64748B" />
                                <Label Text="{Binding PacoteEncontrado.DataEnvio}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#0F172A" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label Text="Previsão de entrega" FontSize="12" TextColor="#64748B" />
                                <Label Text="{Binding PacoteEncontrado.DataPrevistaEntrega}"
                                       FontSize="15"
                                       FontAttributes="Bold"
                                       TextColor="#0F766E" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Linha do tempo -->
                <Label Text="Histórico"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#0F172A"
                       Margin="4,4,0,0" />

                <Border BackgroundColor="White" Stroke="#E3EAE8" StrokeThickness="1" Padding="20,20,20,4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PacoteEncontrado.HistoricoEventos}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="20,*" ColumnSpacing="14" Margin="0,0,0,20">
                                    <BoxView Grid.Column="0"
                                             WidthRequest="2"
                                             Color="#D5DEDC"
                                             HorizontalOptions="Center"
                                             Margin="0,10,0,-30" />
                                    <Ellipse Grid.Column="0"
                                             WidthRequest="12"
                                             HeightRequest="12"
                                             Fill="#0F766E"
                                             Stroke="#CCFBF1"
                                             StrokeThickness="3"
                                             VerticalOptions="Start"
                                             HorizontalOptions="Center"
                                             Margin="0,4,0,0" />

                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="{Binding Descricao}"
                                               FontSize="15"
                                               FontAttributes="Bold"
                                               TextColor="#0F172A" />
                                        <Label Text="{Binding Local}"
                                               FontSize="13"
                                               TextColor="#475569" />
                                        <Label Text="{Binding DataHora}"
                                               FontSize="12"
                                               TextColor="#94A3B8" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Nova consulta"
                        Command="{Binding VoltarCommand}"
                        BackgroundColor="#0F766E"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="16"
                        CornerRadius="14"
                        HeightRequest="54" />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
