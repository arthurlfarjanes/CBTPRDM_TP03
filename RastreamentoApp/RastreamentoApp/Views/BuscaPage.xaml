<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RastreamentoApp.Views.BuscaPage"
             Title="Rastreamento Logístico"
             BackgroundColor="#F3F4F6">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20" VerticalOptions="Center">

            <!-- Cabeçalho -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="📦"
                       FontSize="56"
                       HorizontalOptions="Center" />
                <Label Text="Rastrear Encomenda"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#1F2937"
                       HorizontalOptions="Center" />
                <Label Text="Insira o código de rastreamento abaixo para acompanhar o status em tempo real."
                       FontSize="14"
                       TextColor="#6B7280"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Card de Entrada -->
            <Frame BackgroundColor="White"
                   CornerRadius="12"
                   Padding="20"
                   HasShadow="True"
                   BorderColor="#E5E7EB">
                <VerticalStackLayout Spacing="16">
                    <Label Text="Código do Pacote"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="#374151" />

                    <Entry Placeholder="Ex: BR123456789"
                           Text="{Binding CodigoRastreamento}"
                           FontSize="16"
                           TextColor="#111827"
                           PlaceholderColor="#9CA3AF"
                           ClearButtonVisibility="WhileEditing"
                           ReturnCommand="{Binding BuscarPacoteCommand}" />

                    <Button Text="Rastrear Pacote"
                            Command="{Binding BuscarPacoteCommand}"
                            BackgroundColor="#2563EB"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="16"
                            CornerRadius="8"
                            HeightRequest="50" />
                </VerticalStackLayout>
            </Frame>

            <!-- Códigos de Teste Rápido -->
            <Frame BackgroundColor="#EFF6FF"
                   CornerRadius="10"
                   Padding="16"
                   BorderColor="#BFDBFE"
                   HasShadow="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="💡 Códigos disponíveis para simulação (toque para preencher):"
                           FontSize="13"
                           FontAttributes="Bold"
                           TextColor="#1E40AF" />

                    <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween">
                        <Button Text="BR123456789"
                                Command="{Binding PreencherCodigoCommand}"
                                CommandParameter="BR123456789"
                                BackgroundColor="White"
                                TextColor="#1D4ED8"
                                BorderColor="#93C5FD"
                                BorderWidth="1"
                                FontSize="12"
                                CornerRadius="6"
                                Margin="0,4" />

                        <Button Text="BR987654321"
                                Command="{Binding PreencherCodigoCommand}"
                                CommandParameter="BR987654321"
                                BackgroundColor="White"
                                TextColor="#1D4ED8"
                                BorderColor="#93C5FD"
                                BorderWidth="1"
                                FontSize="12"
                                CornerRadius="6"
                                Margin="0,4" />

                        <Button Text="BR555666777"
                                Command="{Binding PreencherCodigoCommand}"
                                CommandParameter="BR555666777"
                                BackgroundColor="White"
                                TextColor="#1D4ED8"
                                BorderColor="#93C5FD"
                                BorderWidth="1"
                                FontSize="12"
                                CornerRadius="6"
                                Margin="0,4" />
                    </FlexLayout>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>